# Telegram bot service. Needs OCR system binaries (Ghostscript, Tesseract)
# for the PDF ingestion pipeline (app/services/pdf_parser.py) that the API
# service doesn't need, which is why it's a separate image from Dockerfile.api.
FROM python:3.11-slim

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ghostscript \
        tesseract-ocr \
        tesseract-ocr-rus \
        libgomp1 \
        ffmpeg \
        curl \
        xvfb \
        xauth \
        libx11-6 libxcb1 libxext6 libxrender1 libxi6 libsm6 libice6 \
        libfontconfig1 libfreetype6 libdbus-1-3 \
        libgl1 libglx-mesa0 libegl1 \
        libxkbcommon0 libxkbcommon-x11-0 \
        libxcb-cursor0 libxcb-icccm4 libxcb-image0 libxcb-keysyms1 libxcb-randr0 \
        libxcb-render-util0 libxcb-shape0 libxcb-sync1 libxcb-xfixes0 libxcb-xinerama0 libxcb-glx0 \
    && rm -rf /var/lib/apt/lists/*

# ODA File Converter — free, no-login-required DWG<->DXF converter
# (app/services/cad_parser.py::convert_dwg_to_dxf). It's a Qt6 GUI app with
# no offscreen QPA plugin, so it needs a real (virtual) display — xvfb-run
# above provides that. /usr/bin/ODAFileConverter is the app's own thin
# argv-passthrough wrapper (installed by the .deb); oda-convert.sh below is
# ours, adding the xvfb-run layer cad_parser.py's plain subprocess.run
# doesn't add itself. Version pinned by URL; bump both when upgrading.
RUN curl -fsSL -o /tmp/oda.deb \
        "https://www.opendesign.com/guestfiles/get?filename=ODAFileConverter_QT6_lnxX64_8.3dll_27.1.deb" \
    && apt-get update \
    && apt-get install -y --no-install-recommends /tmp/oda.deb \
    && rm -rf /var/lib/apt/lists/* /tmp/oda.deb \
    && printf '#!/bin/sh\nexec xvfb-run -a /usr/bin/ODAFileConverter "$@"\n' > /usr/local/bin/oda-convert.sh \
    && chmod +x /usr/local/bin/oda-convert.sh

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY app ./app
COPY scripts ./scripts
COPY alembic ./alembic
COPY alembic.ini .
# Root docs, ingested into RAG at startup (app/services/project_docs_ingest.py)
# so chat and the todo-capture parser are grounded in the real project docs.
COPY ARCHITECTURE.md README.md AUTONOMOUS_EXECUTION.md DEVELOPMENT_TOOLS.md \
     OPEN_SOURCE_STRATEGY.md INSTALL.md DEPLOYMENT.md LED_Master_Knowledge_Base.md ./
# Baseline fallback if the bind mount from docker-compose.prod.yml isn't
# present (e.g. running the image standalone) — real config is meant to be
# edited on the host and bind-mounted over this.
COPY screens_map.yaml .
# capabilities.yaml is a code artifact (kept up to date alongside features,
# not site config), so it's baked into the image, not bind-mounted.
COPY capabilities.yaml .
# Generated on the host from `git log` right before this build (not
# committed — see .gitignore) — read at startup by
# app/bot/main.py::notify_admins_of_restart to tell admins what's new via
# Telegram on every deploy, not just that a restart happened. The deploy
# step must create this file (even empty) before `docker build`, since
# COPY of a missing file fails the build.
COPY DEPLOY_CHANGELOG.txt .

RUN mkdir -p data/chroma_db data/logs data/temp data/media/Draw

CMD ["python", "-m", "app.bot.main"]
