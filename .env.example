# Telegram
BOT_TOKEN=
ADMIN_IDS=123456789,987654321

# Local LLM (Ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# Lower temperature/top_p than Ollama's defaults (0.8/0.9) to make the local
# model less prone to confidently inventing specifics (prices, part numbers).
OLLAMA_TEMPERATURE=0.35
OLLAMA_TOP_P=0.85
OLLAMA_TOP_K=40
OLLAMA_REPEAT_PENALTY=1.15
OLLAMA_NUM_PREDICT=512

# Speech-to-text (Faster-Whisper) for voice messages
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=ru

# Cloud LLM (Anthropic Claude)
# Set to true to let the cascade escalate to Claude when the local model is
# unavailable or low-confidence. Off by default.
CLOUD_ENABLED=false
ANTHROPIC_API_KEY=
CLOUD_MODEL_NAME=claude-3-5-sonnet-20241022
CLOUD_DAILY_LIMIT_PER_USER=50
# Optional: route Claude API calls through an HTTP proxy (e.g. the Gluetun
# VPN sidecar in docker-compose.prod.yml). Leave empty for a direct connection.
ANTHROPIC_PROXY_URL=

# RAG
# Raised from 0.65 - at that level even weak/tangential matches were treated
# as grounding context, so the local model would answer from them regardless
# of how loosely they actually applied.
RAG_SCORE_THRESHOLD=0.75
CHROMA_PERSIST_DIR=./data/chroma_db
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Database (used directly for local, non-Docker development)
POSTGRES_DSN=postgresql+asyncpg://ppai:ppai@localhost:5432/ppai
REDIS_URL=redis://localhost:6379/0

# --- docker-compose.prod.yml only ---
# Initializes the `postgres` container itself; docker-compose.prod.yml
# rebuilds POSTGRES_DSN above from these to point at the `postgres` service,
# so you don't need to edit POSTGRES_DSN by hand for a Docker deployment.
POSTGRES_USER=ppai
POSTGRES_PASSWORD=
POSTGRES_DB=ppai

# Self-hosted WireGuard VPN (optional, disabled by default — see the "vpn"
# compose profile in docker-compose.prod.yml). Used only by the `gluetun`
# sidecar to route Anthropic Claude API calls; nothing else. Get these four
# values from the WireGuard client config for this server (NOT the obfuscated
# AmneziaWG protocol, which gluetun cannot speak):
#   VPN_ENDPOINT_IP/PORT      = [Peer] Endpoint host:port
#   VPN_SERVER_PUBLIC_KEY     = [Peer] PublicKey
#   VPN_CLIENT_PRIVATE_KEY    = [Interface] PrivateKey
#   VPN_CLIENT_ADDRESS        = [Interface] Address (e.g. 10.8.1.2/32)
VPN_ENDPOINT_IP=
VPN_ENDPOINT_PORT=51820
VPN_SERVER_PUBLIC_KEY=
VPN_CLIENT_PRIVATE_KEY=
VPN_CLIENT_ADDRESS=
VPN_PRESHARED_KEY=

# Observability
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Security
SECRET_KEY=change-me-in-production
INTERNAL_API_TOKEN=change-me-internal-token
JWT_ALGORITHM=HS256
JWT_EXPIRES_HOURS=8
OTT_EXPIRES_SECONDS=300

# GitHub Planning (Loki: say "план3"/"тодолист3" in chat to capture a todo
# into PLANNING.md). Create a fine-grained PAT scoped to just this one repo
# with "Contents: Read and write" permission at
# github.com/settings/personal-access-tokens
GITHUB_TOKEN=
GITHUB_REPO=tapokpy/ppai
GITHUB_PLANNING_FILE_PATH=PLANNING.md
GITHUB_PLANNING_BRANCH=claude/review-files-plan-rn4l2a
