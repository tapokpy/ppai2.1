# Telegram
BOT_TOKEN=
ADMIN_IDS=123456789,987654321

# Local LLM (Ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b

# Speech-to-text (Faster-Whisper) for voice messages
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=ru

# Cloud LLM (Anthropic Claude)
ANTHROPIC_API_KEY=
CLOUD_MODEL_NAME=claude-3-5-sonnet-20241022
CLOUD_DAILY_LIMIT_PER_USER=50
# Optional: route Claude API calls through an HTTP proxy (e.g. the Gluetun
# VPN sidecar in docker-compose.prod.yml). Leave empty for a direct connection.
ANTHROPIC_PROXY_URL=

# RAG
RAG_SCORE_THRESHOLD=0.65
CHROMA_PERSIST_DIR=./data/chroma_db
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Database (used directly for local, non-Docker development)
POSTGRES_DSN=postgresql+asyncpg://ppai:ppai@localhost:5432/ppai
REDIS_URL=redis://localhost:6379/0

# --- docker-compose.prod.yml only ---
# Initializes the `postgres` container itself; docker-compose.prod.yml
# rebuilds POSTGRES_DSN above from these to point at the `postgres` service,
# so you don't need to edit POSTGRES_DSN by hand for a Docker deployment.
POSTGRES_USER=ppai
POSTGRES_PASSWORD=
POSTGRES_DB=ppai

# Mullvad WireGuard config (Mullvad account -> WireGuard configuration ->
# generate a config for your chosen server/country). Used only by the
# `gluetun` VPN sidecar to route Anthropic Claude API calls; nothing else.
MULLVAD_WIREGUARD_PRIVATE_KEY=
MULLVAD_WIREGUARD_ADDRESSES=
MULLVAD_SERVER_COUNTRIES=Sweden

# Observability
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Security
SECRET_KEY=change-me-in-production
INTERNAL_API_TOKEN=change-me-internal-token
JWT_ALGORITHM=HS256
JWT_EXPIRES_HOURS=8
OTT_EXPIRES_SECONDS=300
