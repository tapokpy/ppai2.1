# Telegram
BOT_TOKEN=
ADMIN_IDS=123456789,987654321

# Local LLM (Ollama)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
# Lower temperature/top_p than Ollama's defaults (0.8/0.9) to make the local
# model less prone to confidently inventing specifics (prices, part numbers).
OLLAMA_TEMPERATURE=0.35
OLLAMA_TOP_P=0.85
OLLAMA_TOP_K=40
OLLAMA_REPEAT_PENALTY=1.15
OLLAMA_NUM_PREDICT=512

# Speech-to-text (Faster-Whisper) for voice messages
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=ru

# Cloud LLM (Anthropic Claude)
# Set to true to let the cascade escalate to Claude when the local model is
# unavailable or low-confidence. Off by default.
CLOUD_ENABLED=false
ANTHROPIC_API_KEY=
CLOUD_MODEL_NAME=claude-3-5-sonnet-20241022
CLOUD_DAILY_LIMIT_PER_USER=50
# Optional: route Claude API calls through an HTTP proxy (e.g. the Gluetun
# VPN sidecar in docker-compose.prod.yml). Leave empty for a direct connection.
ANTHROPIC_PROXY_URL=

# RAG
# Raised from 0.65 - at that level even weak/tangential matches were treated
# as grounding context, so the local model would answer from them regardless
# of how loosely they actually applied.
RAG_SCORE_THRESHOLD=0.75
CHROMA_PERSIST_DIR=./data/chroma_db
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2

# Database (used directly for local, non-Docker development)
POSTGRES_DSN=postgresql+asyncpg://ppai:ppai@localhost:5432/ppai
REDIS_URL=redis://localhost:6379/0

# --- docker-compose.prod.yml only ---
# Initializes the `postgres` container itself; docker-compose.prod.yml
# rebuilds POSTGRES_DSN above from these to point at the `postgres` service,
# so you don't need to edit POSTGRES_DSN by hand for a Docker deployment.
POSTGRES_USER=ppai
POSTGRES_PASSWORD=
POSTGRES_DB=ppai

# Self-hosted WireGuard VPN (optional, disabled by default — see the "vpn"
# compose profile in docker-compose.prod.yml). Used only by the `gluetun`
# sidecar to route Anthropic Claude API calls; nothing else. Get these four
# values from the WireGuard client config for this server (NOT the obfuscated
# AmneziaWG protocol, which gluetun cannot speak):
#   VPN_ENDPOINT_IP/PORT      = [Peer] Endpoint host:port
#   VPN_SERVER_PUBLIC_KEY     = [Peer] PublicKey
#   VPN_CLIENT_PRIVATE_KEY    = [Interface] PrivateKey
#   VPN_CLIENT_ADDRESS        = [Interface] Address (e.g. 10.8.1.2/32)
VPN_ENDPOINT_IP=
VPN_ENDPOINT_PORT=51820
VPN_SERVER_PUBLIC_KEY=
VPN_CLIENT_PRIVATE_KEY=
VPN_CLIENT_ADDRESS=
VPN_PRESHARED_KEY=

# Observability
LANGFUSE_HOST=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Security
SECRET_KEY=change-me-in-production
INTERNAL_API_TOKEN=change-me-internal-token
JWT_ALGORITHM=HS256
JWT_EXPIRES_HOURS=8
OTT_EXPIRES_SECONDS=300

# RAG visualization admin panel (Telegram: /dashboard, admin-only)
# API_INTERNAL_BASE_URL: default already points at the api service over the
# docker network — usually no need to change.
# WEB_DASHBOARD_URL: the address YOUR browser will open — set this to
# whatever actually reaches the frontend container (e.g. http://<host-ip>:8080
# if opening from a different machine than the Docker host).
API_INTERNAL_BASE_URL=http://api:8000/api/v1
WEB_DASHBOARD_URL=http://localhost:8080

# Showroom (Resolume Arena control + media library)
# MEDIA_STORAGE_PATH is the in-container path — bind-mount your real media
# folder to it in docker-compose.prod.yml (e.g. D:/Pappai_Media on Windows).
MEDIA_STORAGE_PATH=/app/data/media
MEDIA_STORAGE_QUOTA_GB=100
SCREENS_MAP_PATH=/app/screens_map.yaml
RESOLUME_OSC_HOST=host.docker.internal
RESOLUME_OSC_PORT=7000
RESOLUME_REST_BASE_URL=http://host.docker.internal:8080/api/v1

# CAD-Engine (drawing analysis/generation)
CAD_STORAGE_PATH=/app/data/media/Draw
# ODA File Converter for .dwg support (https://www.opendesign.com/guestfiles/oda_file_converter)
# is baked into the bot's Docker image (Dockerfile.bot) and wired up via
# docker-compose.prod.yml's `environment:` block, which overrides this blank
# value — leave empty here. Only set this if running the bot outside that
# Docker image, pointing at your own installed executable.
ODA_FILE_CONVERTER_PATH=
CAPABILITIES_PATH=/app/capabilities.yaml

# Warehouse: Google Sheets import (public sheet + API key, no service account)
GOOGLE_SHEETS_API_KEY=
PROJECT_FILES_PATH=/app/data/project_files
